plugin {
  tx_turnstile {
    settings {
      apiScript = {$plugin.tx_turnstile.settings.apiScript}
      challengeTimeout = {$plugin.tx_turnstile.settings.challengeTimeout}
      sendIp = {$plugin.tx_turnstile.settings.sendIp}
      theme = {$plugin.tx_turnstile.settings.theme}
      siteKey = {$plugin.tx_turnstile.settings.siteKey}
      privateKey = {$plugin.tx_turnstile.settings.privateKey}
    }
  }
}
